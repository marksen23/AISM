# Example only – generate your own random values (e.g. openssl rand -hex 32)
AISM_UI_CLIENT_KEY=change-me
AISM_FORWARD_JWT_SECRET=change-me
AISM_INTERNAL_TOKEN=change-me
AISM_QDRANT_API_KEY=change-me
AISM_N8N_WEBHOOK_TOKEN=change-me
AISM_SEARXNG_SECRET=change-me
# Gateway refuses unsigned/invalid policies (default true; set false only for local experiments)
AISM_POLICY_REQUIRE_SIGNATURE=true
AISM_CLOUD_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional WORM audit sink (docker compose --profile audit-worm). Generate with openssl rand -hex 16.
# The example policy leaves this sink optional. AUDIT_SIGNING_KEY is a gateway path, not a compose secret.
# AISM_AUDIT_S3_ACCESS_KEY=
# AISM_AUDIT_S3_SECRET_KEY=
