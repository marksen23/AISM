{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aism:schema:policy:v1alpha1",
  "title": "AISM Governance Policy (S2) – v1alpha1",
  "description": "Policy-as-Code für das AISM-Governance-Gateway (S2). Die $id-URL ist ein Platzhalter. Siehe AISM-Policy-Format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "aism/v1alpha1" },
    "kind": { "const": "GovernancePolicy" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
    "idList": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(s|m|h|d)$",
      "description": "Dauer, z. B. 30s, 1m, 24h, 180d"
    },

    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "owner"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "version": {
          "type": "string",
          "description": "Semantic Versioning 2.0.0",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
        },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{7,64}$", "description": "Git-Commit-SHA (CI) oder Inhalts-Revision (sha256, gesetzt von tools/aism-policy-sign.py); Pflicht bei signierten Policies" },
        "owner": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "effectiveFrom": { "type": "string", "format": "date-time" },
        "changeRef": { "type": "string", "description": "Verweis auf Merge-/Pull-Request" },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "ref"],
          "description": "ssh-sig: abgesetzte SSHSIG-Signatur (Ed25519, Namespace aism-policy) über die exakten Policy-Bytes. Eine Datei .sig ist eine Einzelsignatur (signer Pflicht). Eine Datei .sigs ist ein Bündel mehrerer Signaturen; threshold ist die Mindestzahl verschiedener gültiger Signierer und darf die Schwelle des Schlüsselrings nicht unterschreiten. Andere Methoden werden nur deklariert und vom Referenz-Gateway nicht verifiziert.",
          "properties": {
            "method": { "enum": ["ssh-sig", "git-tag-gpg", "git-tag-ssh", "sigstore-cosign"] },
            "ref": { "type": "string", "minLength": 1 },
            "signer": { "type": "string", "description": "Prinzipal der Einzelsignatur (.sig). Im Bündel (.sigs) stehen die Identitäten nur neben den Signaturen." },
            "threshold": { "type": "integer", "minimum": 1, "maximum": 32, "description": "Mindestzahl verschiedener gültiger Signierer. Pflicht bei ref *.sigs." }
          },
          "if": { "properties": { "method": { "const": "ssh-sig" } }, "required": ["method"] },
          "then": {
            "oneOf": [
              {
                "required": ["signer"],
                "properties": { "ref": { "pattern": "^[A-Za-z0-9._-]+\\.sig$", "description": "Dateiname der Einzelsignatur im Verzeichnis der Policy" } }
              },
              {
                "required": ["threshold"],
                "properties": { "ref": { "pattern": "^[A-Za-z0-9._-]+\\.sigs$", "description": "Dateiname des Signaturbündels im Verzeichnis der Policy" } }
              }
            ]
          }
        }
      }
    },

    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults", "subjects", "piiDetectors", "dataClasses", "routing", "tools", "rag", "audit"],
      "properties": {
        "defaults": { "$ref": "#/$defs/defaults" },
        "subjects": { "$ref": "#/$defs/subjects" },
        "piiDetectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/piiDetector" } },
        "dataClasses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dataClass" } },
        "routing": { "$ref": "#/$defs/routing" },
        "tools": { "$ref": "#/$defs/tools" },
        "rag": { "$ref": "#/$defs/rag" },
        "webSearch": { "$ref": "#/$defs/webSearch" },
        "audit": { "$ref": "#/$defs/audit" }
      }
    },

    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "route", "failMode"],
      "properties": {
        "decision": { "const": "deny", "description": "Default deny ist nicht abschaltbar." },
        "route": { "const": "local" },
        "failMode": { "const": "closed" },
        "maxToolRounds": { "type": "integer", "minimum": 0, "maximum": 20, "default": 5 },
        "maxRequestBytes": { "type": "integer", "minimum": 1024 }
      }
    },

    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "identitySources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "type": { "enum": ["oidc-bearer", "forwarded-jwt-hs256", "api-key"] },
              "issuer": { "type": "string" },
              "audience": { "type": "string" },
              "jwksUri": { "type": "string" },
              "header": { "type": "string" },
              "secretRef": { "$ref": "#/$defs/secretRef" },
              "client": { "$ref": "#/$defs/id" }
            }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "match"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "description": { "type": "string" },
              "match": {
                "type": "object",
                "additionalProperties": false,
                "required": ["claim", "anyOf"],
                "properties": {
                  "claim": { "type": "string" },
                  "anyOf": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                }
              }
            }
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },

    "secretRef": {
      "type": "string",
      "pattern": "^(env|file):[A-Za-z0-9_./-]+$",
      "description": "Verweis auf ein Secret; Klartext-Secrets sind in der Policy unzulässig."
    },

    "masking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["placeholder", "redact", "hash"] },
        "placeholderFormat": { "type": "string", "pattern": "^<[A-Z_]+_\\{n\\}>$", "description": "z. B. <EMAIL_{n}>" },
        "reversible": { "type": "boolean", "default": false },
        "demaskFor": { "$ref": "#/$defs/idList", "description": "Rollen, für die im Rückweg demaskiert wird (PEP-10)" }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "const": "placeholder" } } },
          "then": { "required": ["placeholderFormat"] }
        },
        {
          "if": { "properties": { "strategy": { "enum": ["redact", "hash"] } } },
          "then": { "properties": { "reversible": { "const": false } } }
        }
      ]
    },

    "piiDetector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity", "type", "masking"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entity": { "type": "string", "pattern": "^[A-Z][A-Z_]*$" },
        "type": { "enum": ["regex", "ner", "checksum", "gazetteer"] },
        "patterns": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "ner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "labels", "minScore"],
          "properties": {
            "model": {
              "type": "string",
              "pattern": "^(spacy|gliner):\\S+$",
              "description": "spacy:<modell> (minScore wird ignoriert) oder gliner:<modell> (minScore ist die Schwelle; Labels z. B. person)"
            },
            "labels": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "minScore": { "type": "number", "minimum": 0, "maximum": 1 },
            "languages": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]{2}$" } },
            "cascade": {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "labels", "minScore"],
              "description": "Optionales schwereres NER-Modell. Es läuft nur auf verdächtigen Sätzen; die Treffer werden mit dem primären Modell vereinigt. Fehlt der Schlüssel, ist die Kaskade aus (kein torch nötig). Ist sie gesetzt und das Modell nicht ladbar, verweigert das Gateway den Start (fail-closed), ohne auf das schnelle Modell allein zurückzufallen.",
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^(spacy|gliner):\\S+$",
                  "description": "Sekundärmodell, gleiche Schreibweise wie ner.model. Beispiel: gliner:urchade/gliner_multi_pii-v1"
                },
                "labels": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "minScore": { "type": "number", "minimum": 0, "maximum": 1 },
                "triggers": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Welche Verdachtssignale das Sekundärmodell starten. Fehlende Schlüssel nutzen die Defaults. Alle false lädt das Modell trotzdem; ein Ladefehler bleibt fail-closed.",
                  "properties": {
                    "capitalizedUnknown": { "type": "boolean", "default": true, "description": "Großgeschriebenes namensförmiges Token, nicht am Satzanfang, nicht im deutschen Wortlexikon" },
                    "sentenceStartUnknown": { "type": "boolean", "default": true, "description": "Satzanfang-Token außerhalb des Wortlexikons (gewöhnliche Satzanfänge stehen im Lexikon)" },
                    "unknownBigram": { "type": "boolean", "default": true, "description": "Zwei benachbarte großgeschriebene Tokens, mindestens eines außerhalb des Lexikons" },
                    "unknownLowerBigram": { "type": "boolean", "default": true, "description": "Zwei benachbarte nicht beide großgeschriebene namensförmige Tokens, mindestens eines außerhalb des Lexikons" },
                    "listedGivenName": { "type": "boolean", "default": false, "description": "Token auf der eingebauten Vornamensliste. Großschreibung zählt immer; Kleinschreibung nur, wenn das Token nicht im Wortlexikon steht (sonst träfe das Verb bin). Standard aus: auf dem Dev-Satz hob der Trigger den Recall kaum und verdoppelte fast die Auslöserate." },
                    "nearPersonCue": { "type": "boolean", "default": true, "description": "Namensförmiges Token nahe Herr/Frau/Dr., Signatur, Gruß, Ansprechpartner, i. V., Ich bin" },
                    "lowConfidence": { "type": "boolean", "default": true, "description": "Primärtreffer unter lowConfidenceBelow. spaCy-Kleinmodelle haben keinen Score; es wird die Beam-Marge genutzt, sonst bleibt der Trigger still" },
                    "lowConfidenceBelow": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
                    "cueWindowTokens": { "type": "integer", "minimum": 1, "maximum": 12, "default": 4 },
                    "minTokenLength": { "type": "integer", "minimum": 2, "maximum": 12, "default": 3 },
                    "maxSentenceChars": { "type": "integer", "minimum": 80, "maximum": 8000, "default": 2000, "description": "Längere Sätze: das Sekundärmodell sieht nur ein Fenster um die verdächtigen Tokens" }
                  }
                }
              }
            }
          }
        },
        "gazetteer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["givenNames", "surnames"],
          "description": "Listenreferenz builtin:de-given / builtin:de-surnames oder file:<relativer Pfad>. contextPreset de ist der deutsche Referenzregelsatz; contextRules ersetzt ihn.",
          "properties": {
            "givenNames": { "type": "string", "pattern": "^(builtin:de-given|file:[A-Za-z0-9_./-]+)$" },
            "surnames": { "type": "string", "pattern": "^(builtin:de-surnames|file:[A-Za-z0-9_./-]+)$" },
            "matchPairs": { "type": "boolean", "default": true, "description": "Vorname unmittelbar gefolgt von Nachname, unabhängig von der Großschreibung" },
            "contextPreset": { "enum": ["de", "none"], "default": "de" },
            "contextRules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["accept", "patterns"],
                "properties": {
                  "accept": {
                    "enum": ["cue", "gazetteer-all", "gazetteer-any"],
                    "description": "cue: ein Token nur wenn gelistet, zwei oder drei namensförmige Token auch sonst. gazetteer-all: jedes Token gelistet. gazetteer-any: mindestens eines."
                  },
                  "patterns": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
                }
              }
            }
          }
        },
        "checksum": { "enum": ["iban-mod97", "luhn"] },
        "applyTo": {
          "type": "array",
          "items": { "enum": ["prompt", "tool_result", "rag_ingest", "web_query", "response"] },
          "uniqueItems": true,
          "default": ["prompt", "tool_result", "rag_ingest", "web_query"]
        },
        "masking": { "$ref": "#/$defs/masking" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "regex" } } }, "then": { "required": ["patterns"] } },
        { "if": { "properties": { "type": { "const": "ner" } } }, "then": { "required": ["ner"] } },
        { "if": { "properties": { "type": { "const": "checksum" } } }, "then": { "required": ["patterns", "checksum"] } },
        { "if": { "properties": { "type": { "const": "gazetteer" } } }, "then": { "required": ["gazetteer"] } }
      ]
    },

    "dataClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rank"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rank": { "type": "integer", "minimum": 0, "description": "Höher = schutzbedürftiger. Die höchste zutreffende Klasse gilt." },
        "description": { "type": "string" },
        "assignWhen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "detectedEntities": { "type": "array", "items": { "type": "string" } },
            "collections": { "$ref": "#/$defs/idList" },
            "roles": { "$ref": "#/$defs/idList" },
            "always": { "type": "boolean" }
          }
        }
      }
    },

    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloudEnabled", "providers", "rules"],
      "properties": {
        "cloudEnabled": { "type": "boolean", "description": "Globaler Schalter; false = kein Cloud-Egress, unabhängig von Regeln" },
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "endpoint", "models"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "type": { "enum": ["local", "cloud"] },
              "endpoint": { "type": "string", "pattern": "^https?://" },
              "models": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "credentialRef": { "$ref": "#/$defs/secretRef" },
              "notes": { "type": "string" }
            },
            "allOf": [
              {
                "if": { "properties": { "type": { "const": "cloud" } } },
                "then": { "required": ["credentialRef"], "properties": { "endpoint": { "pattern": "^https://" } } }
              }
            ]
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "priority", "when", "route"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
              "description": { "type": "string" },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "dataClasses": { "$ref": "#/$defs/idList" },
                  "roles": { "$ref": "#/$defs/idList" },
                  "agents": { "$ref": "#/$defs/idList" },
                  "models": { "type": "array", "items": { "type": "string" } }
                }
              },
              "route": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["local-only", "local-with-cloud-fallback", "deny"] },
                  "localProviders": { "$ref": "#/$defs/idList" },
                  "cloudProviders": { "$ref": "#/$defs/idList", "description": "Provider-Allowlist für den Fallback" },
                  "fallbackOn": {
                    "type": "array",
                    "items": { "enum": ["local_unavailable", "local_overloaded", "context_too_large", "model_not_available_locally"] },
                    "uniqueItems": true
                  }
                },
                "allOf": [
                  {
                    "if": { "properties": { "mode": { "const": "local-with-cloud-fallback" } } },
                    "then": { "required": ["cloudProviders", "fallbackOn"] }
                  }
                ]
              }
            }
          }
        }
      }
    },

    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitions"],
      "properties": {
        "requireConfirmationForWrite": { "type": "boolean", "default": true },
        "definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "gateway", "target", "access", "argumentsSchema", "allow"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$", "description": "Muss dem Funktionsnamen im tools-Array entsprechen" },
              "description": { "type": "string" },
              "gateway": { "enum": ["n8n-webhook", "mcp"] },
              "target": { "type": "string", "minLength": 1, "description": "n8n-Webhook-Pfad oder MCP-Server-ID" },
              "access": { "enum": ["read", "write"] },
              "parameterized": { "type": "boolean", "const": true, "default": true, "description": "Argumente werden gebunden, nie in Code/SQL interpoliert" },
              "argumentsSchema": {
                "type": "object",
                "required": ["type", "additionalProperties"],
                "properties": {
                  "type": { "const": "object" },
                  "additionalProperties": { "const": false }
                }
              },
              "allow": {
                "type": "object",
                "additionalProperties": false,
                "required": ["roles"],
                "properties": {
                  "roles": { "$ref": "#/$defs/idList" },
                  "agents": { "$ref": "#/$defs/idList" },
                  "maxDataClassRank": { "type": "integer", "minimum": 0 }
                }
              },
              "rateLimit": {
                "type": "object",
                "additionalProperties": false,
                "required": ["requests", "per", "scope"],
                "properties": {
                  "requests": { "type": "integer", "minimum": 1 },
                  "per": { "$ref": "#/$defs/duration" },
                  "scope": { "enum": ["subject", "agent", "global"] }
                }
              },
              "timeout": { "$ref": "#/$defs/duration" },
              "requireConfirmation": { "type": "boolean" },
              "maskResult": { "type": "boolean", "const": true, "default": true }
            },
            "allOf": [
              {
                "if": { "properties": { "access": { "const": "write" } } },
                "then": { "required": ["requireConfirmation", "rateLimit"] }
              }
            ]
          }
        }
      }
    },

    "rag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireMaskedQuery", "embeddingModel", "collections"],
      "properties": {
        "requireMaskedQuery": { "const": true },
        "maskOnIngest": { "type": "boolean", "default": true },
        "embeddingModel": { "type": "string" },
        "maxChunks": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 },
        "collections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "allow", "filter"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,255}$" },
              "dataClass": { "$ref": "#/$defs/id" },
              "allow": {
                "type": "object",
                "additionalProperties": false,
                "required": ["roles"],
                "properties": { "roles": { "$ref": "#/$defs/idList" } }
              },
              "filter": {
                "type": "object",
                "additionalProperties": false,
                "required": ["payloadKey", "valuesFrom"],
                "properties": {
                  "payloadKey": { "type": "string" },
                  "valuesFrom": { "enum": ["roles", "claim"] },
                  "claim": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },

    "webSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roles": { "$ref": "#/$defs/idList" },
            "maxDataClassRank": { "type": "integer", "minimum": 0 }
          }
        },
        "stripPlaceholders": { "type": "boolean", "default": true },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },

    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sink", "events", "plaintextPII", "retention", "decisionLog"],
      "properties": {
        "sink": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["file-jsonl", "syslog", "otlp-logs"] },
            "path": { "type": "string" },
            "endpoint": { "type": "string" }
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "request.accepted", "request.denied", "pii.masked", "route.decided",
              "egress.cloud", "egress.websearch", "rag.query", "tool.call.allowed",
              "tool.call.denied", "tool.result", "stream.completed", "stream.aborted",
              "policy.loaded", "policy.load_failed",
              "tool.call.pending", "tool.call.confirmed", "tool.call.rejected"
            ]
          }
        },
        "plaintextPII": { "const": false },
        "storePayloadHash": { "type": "boolean", "default": true },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["days"],
          "properties": {
            "days": { "type": "integer", "minimum": 1 },
            "basis": { "type": "string", "description": "Verweis auf interne Aufbewahrungsvorgabe; rechtliche Fristen sind nicht Teil dieses Formats" }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hashChain": { "type": "boolean" },
            "algorithm": { "enum": ["sha256", "sha512"] }
          }
        },
        "decisionLog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "includeRuleTrace": { "type": "boolean", "default": true }
          }
        },
        "traceContext": { "enum": ["w3c-traceparent", "none"], "default": "w3c-traceparent" }
      }
    }
  }
}
